# Copie para server/.env (este arquivo de verdade NUNCA vai para o Git).

# true = resposta simulada, sem gastar créditos. false = IA de verdade.
MOCK_AI=true

# Só precisa quando MOCK_AI=false. Crie em console.anthropic.com.
ANTHROPIC_API_KEY=

# Opcional: troca o modelo sem mexer no código.
# ANTHROPIC_MODEL=claude-haiku-5-5

# Opcional: porta do servidor.
# PORT=3333
